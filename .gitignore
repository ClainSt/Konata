*.log


android/.kotlin/


# Native runtime binaries (track manifest-verified windows & android runtimes; keep reference/ & unpacked C headers untracked)
/native/*
!/native/konata-native/
/native/konata-native/*
!/native/konata-native/*-manifest.json
!/native/konata-native/windows-headers.zip
!/native/konata-native/windows/
/native/konata-native/windows/include/
/native/konata-native/windows/reference/
!/native/konata-native/android/

# Portable runtime data & local debug databases
/userdata/
/cache/
/Konata_*/
/*.db
/*.db-wal
/*.db-shm
/*.db-journal

# Keep project notes local.
*.[mM][dD]
!/AGENTS.md
!/README.md
!/packages/**/KONATA_PATCH*.md
!/tool/native/README.md
/photos/
/.agent-work/

# Local ad-hoc dataset audit scripts
/tool/audit_*.dart
/tool/benchmark_cloud.dart
.agent-work/
.codex/
.agent/

# Local dart-define & wrangler secret/cache files (never commit)
dart_defines.dev.json
dart_defines.local.json
**/.wrangler/
**/.dev.vars
