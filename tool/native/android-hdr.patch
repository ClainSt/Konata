+static struct pl_color_space android_color_space(struct ra_ctx *ctx)
+{
+    struct priv *p = ctx->priv;
+    // Leave the established SDR defaults untouched.
+    if (!p->pq)
+        return (struct pl_color_space){0};
+    return (struct pl_color_space) {
+        .primaries = PL_COLOR_PRIM_BT_2020,
+        .transfer = PL_COLOR_TRC_PQ,
+        .hdr.max_luma = p->peak,
+    };
+}
+
+// Called on the VO thread before configuring/rendering the new source frame.
+// A native window can own only one EGL window surface at a time.
+static bool android_create_surface(struct ra_ctx *ctx, bool pq)
+{
+    struct priv *p = ctx->priv;
     if (p->egl_surface) {
         eglMakeCurrent(p->egl_display, EGL_NO_SURFACE, EGL_NO_SURFACE,
                        EGL_NO_CONTEXT);
         eglDestroySurface(p->egl_display, p->egl_surface);
+        p->egl_surface = EGL_NO_SURFACE;
+    }
+    EGLint attributes[] = { EGL_GL_COLORSPACE_KHR,
+                            EGL_GL_COLORSPACE_BT2020_PQ_EXT, EGL_NONE };
+    p->egl_surface = eglCreateWindowSurface(p->egl_display, p->egl_config,
+        (EGLNativeWindowType)vo_android_native_window(ctx->vo), pq ? attributes : NULL);
+    if (p->egl_surface == EGL_NO_SURFACE)
+        return false;
+    if (pq) {
+        EGLint actual = 0;
+        if (!eglQuerySurface(p->egl_display, p->egl_surface,
+                             EGL_GL_COLORSPACE_KHR, &actual) ||
+            actual != EGL_GL_COLORSPACE_BT2020_PQ_EXT)
+            return false;
+    }
+    if (!eglMakeCurrent(p->egl_display, p->egl_surface, p->egl_surface,
+                        p->egl_context))
+        return false;
+    p->pq = pq;
+    MP_INFO(ctx, "Konata output: %s (EGL), peak=%d\n",
+            pq ? "bt.2020/pq" : "sdr", pq ? p->peak : 0);
+    return true;
+}
