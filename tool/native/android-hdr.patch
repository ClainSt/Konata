+static bool android_update_color(struct ra_ctx *ctx)
+{
+    struct priv *p = ctx->priv;
+    m_config_cache_update(p->video_opts);
+    struct gl_video_opts *opts = p->video_opts->opts;
+    struct mp_image_params *source = ctx->vo->params;
+    struct mp_image_params fallback = source ? *source : (struct mp_image_params){0};
+    mp_image_params_restore_dovi_mapping(&fallback);
+    const bool source_pq = source && fallback.color.transfer == PL_COLOR_TRC_PQ;
+    const bool compatible =
+        (opts->target_trc == PL_COLOR_TRC_UNKNOWN || opts->target_trc == PL_COLOR_TRC_PQ) &&
+        (opts->target_prim == PL_COLOR_PRIM_UNKNOWN || opts->target_prim == PL_COLOR_PRIM_BT_2020);
+    const char *extensions = eglQueryString(p->egl_display, EGL_EXTENSIONS);
+    bool pq = source_pq && compatible && ctx->vo->opts->android_hdr_peak > 0 &&
+              !p->pq_failed && extensions &&
+              gl_check_extension(extensions, "EGL_EXT_gl_colorspace_bt2020_pq");
+    const EGLint channels[] = {EGL_RED_SIZE, EGL_GREEN_SIZE, EGL_BLUE_SIZE};
+    for (int i = 0; pq && i < 3; i++) {
+        EGLint depth = 0;
+        pq = eglGetConfigAttrib(p->egl_display, p->egl_config, channels[i], &depth) && depth >= 10;
+    }
+    p->peak = ctx->vo->opts->android_hdr_peak;
+    if (pq != p->pq && !android_create_surface(ctx, pq)) {
+        // Do not keep retrying an unsupported driver combination each frame.
+        p->pq_failed = true;
+        MP_WARN(ctx, "HDR EGL surface unavailable; returning to SDR\n");
+        if (!android_create_surface(ctx, false))
+            return false;
+    }
+    // Never silently label explicitly requested HDR pixels as SDR. Automatic
+    // targets use the actual framebuffer space and safely tone-map on failure.
+    if (!p->pq && (opts->target_trc == PL_COLOR_TRC_PQ ||
+                   opts->target_trc == PL_COLOR_TRC_HLG)) {
+        MP_ERR(ctx, "Explicit HDR target is incompatible with this output\n");
+        return false;
+    }
+    return true;
+}
