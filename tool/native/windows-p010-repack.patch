+// A layout-only 10-bit repack needs no zimg graph or worker pool.
+// Keep explicit scaler choices, resizing, color conversion and filters intact.
+static bool unscaled_p010_repack(struct mp_sws_context *ctx)
+{
+    if (ctx->force_scaler != MP_SWS_AUTO ||
+        ctx->src.imgfmt != pixfmt2imgfmt(AV_PIX_FMT_YUV420P10) ||
+        ctx->dst.imgfmt != IMGFMT_P010 || (ctx->src.w & 1) || (ctx->src.h & 1))
+        return false;
+    struct mp_image_params dst = ctx->dst;
+    dst.imgfmt = ctx->src.imgfmt;
+    dst.repr.bits = ctx->src.repr.bits;
+    if (!mp_image_params_equal(&ctx->src, &dst))
+        return false;
+    struct SwsFilter *filters[] = {ctx->src_filter, ctx->dst_filter};
+    for (int i = 0; i < MP_ARRAY_SIZE(filters); i++) {
+        if (!filters[i])
+            continue;
+        SwsVector *v[] = {filters[i]->lumH, filters[i]->lumV,
+                         filters[i]->chrH, filters[i]->chrV};
+        for (int n = 0; n < MP_ARRAY_SIZE(v); n++) {
+            if (v[n] && (v[n]->length != 1 || v[n]->coeff[0] != 1.0))
+                return false;
+        }
+    }
+    return true;
+}
